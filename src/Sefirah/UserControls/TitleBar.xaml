<UserControl
    x:Class="Sefirah.UserControls.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Sefirah.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="32"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <!--  Native Windows 11 caption strip: 16px icon + caption title on the Mica backdrop.  -->
    <Grid x:Name="AppTitleBar" Height="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Column="0"
            Margin="12,0,0,0"
            Orientation="Horizontal"
            Spacing="8">
            <Image
                x:Name="TitleBarIcon"
                Width="16"
                Height="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Image.Source>
                    <BitmapImage UriSource="{ThemeResource IconPath}" />
                </Image.Source>
            </Image>
            <TextBlock
                x:Name="TitleBarTextBlock"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Sefirah" />
        </StackPanel>
    </Grid>
</UserControl>

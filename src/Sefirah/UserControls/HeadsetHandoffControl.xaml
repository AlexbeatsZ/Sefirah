<UserControl
    x:Class="Sefirah.UserControls.HeadsetHandoffControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Sefirah.ViewModels">
    <Border
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefault}"
        BorderBrush="{ThemeResource CardStrokeColorDefault}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE702;" />
                        <TextBlock FontWeight="SemiBold" Text="Bluetooth devices" />
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SelectedEndpointName, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Padding="8,4"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
                <Button
                    x:Name="VisibilitySettingsButton"
                    Grid.Column="2"
                    Padding="8,4"
                    ToolTipService.ToolTip="Visible Bluetooth devices">
                    <FontIcon Glyph="&#xE713;" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel MinWidth="240" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Visible Bluetooth devices" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Choose which saved devices appear in this card."
                                    TextWrapping="Wrap" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibilityOptions, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:HeadsetVisibilityOption">
                                            <CheckBox
                                                Click="VisibilityCheckBox_Click"
                                                Content="{x:Bind DisplayName}"
                                                IsChecked="{x:Bind IsVisible, Mode=OneWay}"
                                                Tag="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" x:Load="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="Connected to selected device" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedConnectedDevices, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:HeadsetDeviceItem">
                                    <Expander Margin="0,0,0,4">
                                        <Expander.Header>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ConnectionText}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                                            <Button Click="DisconnectButton_Click" Content="Disconnect" Tag="{x:Bind}" />
                                            <Button Click="SwitchButton_Click" Content="Switch connection" Tag="{x:Bind}" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Expander Header="Connected to other devices" IsExpanded="True">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.OtherConnectedDevices, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:HeadsetDeviceItem">
                                    <Expander Margin="0,4">
                                        <Expander.Header>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ConnectionText}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                                            <Button Click="DisconnectButton_Click" Content="Disconnect" Tag="{x:Bind}" />
                                            <Button Click="SwitchButton_Click" Content="Switch here" Tag="{x:Bind}" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Expander>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="Saved on selected device" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Not currently connected" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SavedDisconnectedDevices, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:HeadsetDeviceItem">
                                    <Expander Margin="0,0,0,4">
                                        <Expander.Header>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ConnectionText}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <Button
                                            Margin="0,8,0,0"
                                            Click="SwitchButton_Click"
                                            Content="Connect here"
                                            Tag="{x:Bind}" />
                                    </Expander>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>

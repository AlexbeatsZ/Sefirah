<UserControl
    x:Class="Sefirah.UserControls.HeadsetHandoffControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Sefirah.Data.Models"
    xmlns:viewModels="using:Sefirah.ViewModels">
    <Border
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefault}"
        BorderBrush="{ThemeResource CardStrokeColorDefault}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7F5;" />
                    <TextBlock FontWeight="SemiBold" Text="Headset handoff" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Padding="8,4"
                    Command="{x:Bind ViewModel.DiscoverCommand}"
                    Content="Discover" />
            </Grid>
            <ComboBox
                Header="Headset"
                DisplayMemberPath="DisplayName"
                ItemsSource="{x:Bind ViewModel.Headsets, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedHeadset, Mode=TwoWay}" />
            <ComboBox
                Header="Switch to"
                DisplayMemberPath="DisplayName"
                ItemsSource="{x:Bind ViewModel.Endpoints, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedEndpoint, Mode=TwoWay}" />
            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.SwitchCommand}"
                Content="Switch headset" />
            <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" x:Load="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
